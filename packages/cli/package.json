    "semgrep",
    "gitleaks",
    "osv-scanner",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openqodex": "./dist/bin.js"
  },
  "files": [
    "dist",
    "lenses",
    "docs",
    "skills",
    "templates",
    "demo",
    "toolchain.json",
    "wasm",
    "README.md",

    "@openqodex/graph": "workspace:*",
    "@openqodex/scanners": "workspace:*",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }

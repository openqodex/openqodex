    "sast",
    "security",
    "secret-scanning",
    "linter",
    "code-quality",
    "pre-commit",
    "pre-push",
    "git-hooks",
    "claude-code",
    "claude-code-plugin",
    "agent-skills",
    "cursor",
    "codex",
    "cline",

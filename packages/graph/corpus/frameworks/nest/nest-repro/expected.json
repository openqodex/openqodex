    "plugin": "nest",
    "apps": 1,
    "registrations": [
      { "site": "src/users.controller.ts:4", "methods": ["GET"], "pattern": "/users/:id", "handler": "src/users.controller.ts#UsersController.findOne", "status": "bound", "mounted": false },
      { "site": "src/users.controller.ts:6", "methods": ["POST"], "pattern": "/users", "handler": "src/users.controller.ts#UsersController.create", "status": "bound", "mounted": false }
    ],
    "roles": [{ "target": "src/users.controller.ts#UsersController.findOne", "role": "route_handler", "detail": "nest" }],
    "unknowns": [{ "file": "src/main.ts", "line": 3, "cause": "unsupported-rule" }]
  }
}

{
  "name": "openqodex-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @openqodex/core run build && pnpm --filter @openqodex/scanners run build && pnpm --filter @openqodex/graph run build && pnpm --filter @openqodex/review run build && pnpm --filter @openqodex/mcp run build && pnpm --filter openqodex run build && node scripts/copy-assets.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "golden:record": "node tests/golden/record.mjs",
    "golden:check": "node tests/golden/check.mjs",
    "golden:answer": "node tests/golden/answer.mjs",
    "gate": "bash scripts/gate.sh",
    "changeset": "changeset",
    "docs:index": "node scripts/docs-index.mjs",
    "build:codex-plugin": "node scripts/validate-skill.mjs && node scripts/build-codex-plugin.mjs",
    "version-packages": "changeset version && node scripts/sync-version.mjs && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "toolchain:verify": "node scripts/refresh-toolchain.mjs --verify"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.5",
    "oxlint": "^1.86.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
